div
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-sword-cross
        | Tsujigiri
    .card-content
      .content
        p
          | Today's hidden characters of the tsujigiri battle (Sparkle Shower): one on each song, on any chart.
          | They are the same for everyone and change at midnight in Japan. Beating 理々奈 or 彩葉 unlocks
          | Medicine of love [LEGGENDARIA].
      .field
        label.label Version
        .control
          .select
            select#tg-version
              option(value="33" selected) 33 Sparkle Shower
      .notification.is-light#tg-status Loading...
      table.table.is-fullwidth.is-narrow
        thead
          tr
            th Song
            th Character
        tbody#tg-rows
script(src="static/asset/js/tsujigiri.js")
